{
  "name": "waadafood-kiosko",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && concurrently -k -n cliente,worker \"vite build --watch\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "preact": "^10.26.0",
    "preact-render-to-string": "^6.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@preact/preset-vite": "^2.10.6",
    "concurrently": "^10.0.7",
    "typescript": "~5.9.2",
    "vite": "^6.4.6",
    "wrangler": "^4.0.0"
  }
}
