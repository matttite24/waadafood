{
  "expo": {
    "name": "Waadafood",
    "slug": "waadafood",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "eac532d3-425d-4cef-a8ff-d987cf60c2ae"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/eac532d3-425d-4cef-a8ff-d987cf60c2ae"
    },
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dashboard-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#1E3932"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matttite.chatbox"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}